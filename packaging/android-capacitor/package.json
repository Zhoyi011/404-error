{
  "name": "404-horror-android",
  "version": "1.0.0",
  "description": "伪人入侵 Capacitor Android 客户端（内置离线资源包 + GitHub Releases 自动检测更新）",
  "private": true,
  "scripts": {
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "cap:build-debug": "cd android && ./gradlew assembleDebug",
    "cap:build-release": "cd android && ./gradlew assembleRelease",
    "build:apk": "bash ../build-apk.sh capacitor"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.3",
    "@capacitor/core": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.3"
  }
}
