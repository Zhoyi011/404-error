{
  "name": "404-horror-desktop",
  "version": "1.0.0",
  "description": "伪人入侵 - 独立桌面客户端 (支持 https://404-horror.ai.studio 热更新与本地离线缓存)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "build:exe": "electron-builder --win portable --x64",
    "build:exe-nsis": "electron-builder --win nsis --x64",
    "build:linux": "electron-builder --linux AppImage --x64"
  },
  "build": {
    "appId": "studio.ai.horror404.desktop",
    "productName": "伪人入侵",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "app-dist/**/*",
      "build/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "404-horror-portable-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "404-horror-setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  }
}
